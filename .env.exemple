# Variables d'environnement de Le Renom.
# Copier ce fichier en `.env` à la racine, puis renseigner les valeurs.
# Aucun secret réel ne doit figurer ici : ce fichier est versionné.

# --- Base de données -------------------------------------------------------
# PostgreSQL 16 avec l'extension PostGIS 3.4.
DATABASE_URL="postgresql://postgres:motdepasse@127.0.0.1:5432/lerenom"

# --- File de tâches --------------------------------------------------------
# Redis, utilisé par BullMQ pour la cascade de distribution et les minuteurs.
REDIS_URL="redis://127.0.0.1:6379"

# --- Secrets applicatifs ---------------------------------------------------
# Sert à hacher les codes de vérification SMS. Doit être long et tiré au hasard :
#   openssl rand -hex 32
# Le changer invalide tous les codes en cours de validité, rien de plus.
SECRET_VERIFICATION=""

# --- Environnement ---------------------------------------------------------
# `developpement` autorise la lecture du code de vérification dans la file de
# messages sortants, tant qu'aucun opérateur SMS n'est branché. Jamais en production.
LERENOM_ENV="developpement"

# --- Espace professionnel ---------------------------------------------------
# Adresse publique du site, utilisée pour écrire les liens dans les SMS et les courriels.
LERENOM_URL="http://localhost:3000"
