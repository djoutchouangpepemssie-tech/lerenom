{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    // Le worker tourne sous `node --experimental-strip-types`, qui exige l'extension réelle.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
