auto-install-peers=true
strict-peer-dependencies=false

# pnpm bloque par défaut les scripts d'installation des dépendances, et c'est une bonne chose :
# un script `postinstall` d'un paquet tiers s'exécute avec tous les droits du développeur.
# Les paquets qui en ont réellement besoin sont nommés un par un dans `pnpm.onlyBuiltDependencies`
# de `package.json` — Prisma télécharge ses moteurs, Tailwind et esbuild installent un binaire
# natif. Sans cette liste, l'installation réussit mais le produit est cassé, ce qui est la pire
# des défaillances : silencieuse.
